{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/ci.yml"
  ],
  "globalEnv": ["CI", "OMNIXA_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OMNIXA_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@omnixa/server#typecheck": {
      "dependsOn": ["@omnixa/core#typecheck"]
    },
    "@omnixa/simulation#typecheck": {
      "dependsOn": ["@omnixa/core#typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@omnixa/ai#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/codemode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@omnixa/httpapi-codegen#test": {
      "outputs": []
    },
    "@omnixa/script#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/script/lint-changed.ts"],
      "outputs": []
    },
    "@omnixa/server#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@omnixa/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
